# Copy this file to ".env" and fill in your values (Supabase -> Project Settings -> API Keys).
# Variables starting with VITE_ are PUBLIC (they are shipped to every visitor's browser).
#
# ALLOWED here : Project URL + Publishable key (sb_publishable_...)
#                (older projects: the "anon" key also works)
# NEVER here   : Secret key (sb_secret_...) or the legacy "service_role" key.
#                The build stops automatically if you do this by mistake.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
